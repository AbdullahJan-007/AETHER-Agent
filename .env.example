# AETHER_MAX_STEPS=40
# AETHER_MAX_OUTPUT_TOKENS=65536
# AETHER_RPM=10
# AETHER_READ_FILE_MAX_BYTES=2000000
# AETHER_HISTORY_CHAR_BUDGET=3000000
# AETHER_CHECK_TIMEOUT_MS=600000
# AETHER_SEARCH_MAX_MATCHES=300
# AETHER_MAX_PROPOSALS=200
